# ============================================================
#  ORTAM DEGISKENLERI ORNEK DOSYASI
# ============================================================
#
#  Bu dosya (.env.example) versiyon kontrolune DAHILDIR.
#  Gercek degerleri iceren `.env` dosyasi ASLA commit edilmez.
#
#  Kullanim:
#    1) Bu dosyayi `.env` olarak kopyalayin
#    2) `.env` icindeki degerleri kendi degerlerinizle degistirin
#    3) `.env` dosyasi .gitignore ile zaten ignore edilir
#
#  DIKKAT: Flutter mobil uygulamalarda `String.fromEnvironment`
#  ile derlenen degerler APK'nin ICINE GOMULUR. APK decompile
#  edildiginde gorunur. Bu yuzden:
#
#    - Gercek SIRLAR icin `--dart-define` KULLANMAYIN.
#    - Sirlari Cloud Functions / sunucu tarafinda tutun.
#    - Buradaki degerler yalnizca gelistirme kolayligidir.
# ============================================================

# ------------------------------------------------------------
#  YONETICI SIFRESI
# ------------------------------------------------------------
# Sifrenin SHA-256 ozeti (hex, kucuk harf).
# Orijinal sifre HICBIR YERDE saklanmaz.
#
# Uretmek icin:
#   node -e "console.log(require('crypto').createHash('sha256').update('SENIN_SIFREN','utf8').digest('hex'))"
#
# ONEMLI: Bu deger APK icine gomulur ve gorunur. Asil dogrulama
# Functions tarafinda yapilir. Bu deger sadece cevrimdisi
# (internet yok) yedek yoldur.
YONETICI_SIFRE_HASH=

# ------------------------------------------------------------
#  SUNUCU DOGRULAMA ADRESI
# ------------------------------------------------------------
# Cloud Function URL'si. Bos birakilirsa uygulama cevrimdisi
# modda yonetici girisini yalnizca gomulu hash ile dogrular.
#
# Deploy sonrasi adres su sekilde olur:
#   https://<region>-<proje-id>.cloudfunctions.net/yoneticiSifresiDogrula
YONETICI_DOGRULAMA_URL=

# ------------------------------------------------------------
#  FIREBASE (ornek degerler - gercek degerler API anahtarlari
#  Firebase Console'dan alinir; bu satirlar sadece yapilandirma
#  ornegi icindir)
# ------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# ------------------------------------------------------------
#  CLOUD FUNCTIONS
# ------------------------------------------------------------
# functions/.env icinde kullanilir (bu dosya commit edilmez).
# Yonetici sifresinin ozeti, sifre dogrulama fonksiyonu icin.
YONETICI_SIFRE_OZET=

# ------------------------------------------------------------
#  GOOGLE SERVICE ACCOUNT (sadece functions/.env icin)
# ------------------------------------------------------------
# Bu anahtar SADECE sunucu tarafinda kullanilir, asla mobil
# uygulamaya girmez.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=