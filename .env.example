# ============================================================
#  ORTAM DEGISKENLERI ORNEK DOSYASI
# ============================================================
#
#  Bu dosya (.env.example) versiyon kontrolune DAHILDIR.
#  Gercek degerleri iceren `.env` dosyasi ASLA commit edilmez.
#
#  Kullanim:
#    1) Bu dosyayi `.env` olarak kopyalayin
#    2) `.env` icindeki degerleri kendi degerlerinizle degistirin
#    3) `.env` dosyasi .gitignore ile zaten ignore edilir
#
#  ------------------------------------------------------------
#  GUVENLIK MODELI
#  ------------------------------------------------------------
#  Yonetici sifresinin KENDISI hicbir dosyada tutulmaz.
#  Yalnizca SHA-256 ozeti saklanir; ozet sifreden geri
#  donuslu hesaplanamaz. Asil dogrulama Cloud Functions'ta
#  yapilir, uygulamadaki gomulu ozet yalnizca cevrimdisi
#  (internet yok) yedek yoldur.
#
#  DIKKAT: Flutter mobil uygulamalarda `String.fromEnvironment`
#  ile derlenen degerler APK'nin ICINE GOMULUR ve APK
#  decompile edildiginde gorunur. Bu yuzden:
#
#    - Gercek SIRLAR icin `--dart-define` KULLANMAYIN
#    - Sirlari Cloud Functions / sunucu tarafinda tutun
#    - Buradaki degerler yalnizca gelistirme kolayligidir
# ============================================================


# ------------------------------------------------------------
#  YONETICI SIFRESI - METIN (yalnizca yerel sizinti taramasi)
# ------------------------------------------------------------
# Bu deger APK'ya GOMULMEZ. Yalnizca
# scripts/apk_sizinti_taramasi.js'in "sifre metni APK'da var mi"
# kontrolunde kullanilir. Bos birakirsaniz kontrol atlanir.
#
# Bu deger de gizlidir; dosya zaten .gitignore'da.
YONETICI_SIFRE_ADI=


# ------------------------------------------------------------
#  YONETICI SIFRESI - SHA-256 OZETI
# ------------------------------------------------------------
# Yonetici sifresinin SHA-256 ozeti (hex, kucuk harf).
# Orijinal sifre HICBIR YERDE saklanmaz.
#
# Uretmek icin:
#   node -e "console.log(require('crypto').createHash('sha256').update('SENIN_SIFREN','utf8').digest('hex'))"
#
# Bu deger Cloud Functions tarafindan kullanilir. Canli ortamda
# AYNI degeri Firebase Console > Functions > Environment
# variables bolumune tanimlamalisiniz (canli ortam .env
# dosyasini okumaz).
#
# Bos birakilirsa fonksiyon 503 doner ve HICBIR KISI yonetici
# giremez (guvenli varsayilan).
YONETICI_SIFRE_OZET=


# ------------------------------------------------------------
#  YONETICI SIFRESI - APK'YA GOMULEN YEDEK OZET
# ------------------------------------------------------------
# ONEMLI: Bu deger APK icine gomulur ve gorunur. Asil dogrulama
# Functions tarafinda yapilir; bu deger yalnizca sunucuya
# ulasilamadiginda (internet yok) yonetici girisinin
# calismasini saglar.
#
# Bos birakilirsa cevrimdisi giris calismaz.
YONETICI_SIFRE_HASH=


# ------------------------------------------------------------
#  SUNUCU DOGRULAMA ADRESI
# ------------------------------------------------------------
# Cloud Function URL'si. Bos birakilirsa uygulama cevrimdisi
# modda yonetici girisini yalnizca gomulu hash ile dogrular.
#
# Deploy sonrasi adres su sekilde olur:
#   https://<region>-<proje-id>.cloudfunctions.net/yoneticiSifresiDogrula
YONETICI_DOGRULAMA_URL=


# ------------------------------------------------------------
#  FIREBASE YAPILANDIRMASI
# ------------------------------------------------------------
# Bu degerler `lib/firebase_options.dart` icinde zaten var
# (FlutterFire CLI ile uretilmistir) ve APK'ya gomulur.
# Burada tek yerde toplanmasi, hangi proje/kimlikle
# calistiginizi .env uzerinden gozden gecirmek icindir.
#
# Firebase Console > Proje ayarlari > Genel bolumunden alinir.
#
# Not: API anahtarlari istemci tarafinda gizli sayilmaz.
# Firebase projelerinde API key korumasini saglayan sey guvenlik
# kurallaridir (bkz. firestore.rules).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_PACKAGE=


# ------------------------------------------------------------
#  GOOGLE SERVICE ACCOUNT (yalnizca Cloud Functions / emulator)
# ------------------------------------------------------------
# Bu anahtar SADECE sunucu tarafinda kullanilir, mobil uygulamaya
# ASLA girmez. Canli ortamda Firebase Admin SDK Application
# Default Credentials kullanir; bu degerlere GEREK YOKTUR.
# Yalnizca lokal emulatorde doldurulur.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=