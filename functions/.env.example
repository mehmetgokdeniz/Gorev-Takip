# Functions ortam degiskenleri ornegi.
#
# Bu dosya version kontrolune DAHILDIR; gercek degerler iceren
# functions/.env ASLA commit edilmez.
#
# Kullanim:
#   cp .env.example .env
#   # .env icindeki degerleri kendi degerlerinizle doldurun

# ------------------------------------------------------------
#  YONETICI SIFRESI (ZORUNLU)
# ------------------------------------------------------------
# Yonetici sifresinin SHA-256 ozeti (hex, kucuk harf).
#
# Uretmek icin:
#   node -e "console.log(require('crypto').createHash('sha256').update('SENIN_SIFREN','utf8').digest('hex'))"
#
# Bos birakilirsa fonksiyon 503 doner ve HICBIR KISI yonetici
# giremez (guvenli varsayilan).
YONETICI_SIFRE_OZET=

# ------------------------------------------------------------
#  GOOGLE SERVICE ACCOUNT (yalnizca lokal emulator)
# ------------------------------------------------------------
# Canli ortamda Firebase Admin SDK Application Default Credentials
# kullanir; bu degerlere GEREK YOKTUR, bos birakilabilir.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=