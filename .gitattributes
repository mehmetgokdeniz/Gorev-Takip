# Git line ending ve dosya tipi ayarlari.
# Turkce karakterli dosyalarin (goreli/manifest) farkli platformlarda
# bozulmadan calismasi icin satir sonlari sabitlenir.

* text=auto eol=lf

# Kaynak kod ve yapilandirma dosyalari
*.dart       text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.md         text eol=lf
*.rules      text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.kts        text eol=lf
*.properties text eol=lf
*.example    text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows shell betikleri CRLF bekler
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Ikili dosyalar (asla degistirilmez)
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.ttf        binary
*.otf        binary
*.so         binary
*.aar        binary
*.jar        binary
*.keystore   binary
*.jks        binary
*.p12        binary
*.apk        binary
*.aab        binary
*.pdf        binary